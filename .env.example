DATABASE_URL=postgresql+asyncpg://insights:insights@localhost:5432/insights
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=development-secret-key-minimum-32-bytes-long-change-in-production
JWT_EXPIRE_MINUTES=60
PRIMARY_PROVIDER=openai
FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=86400
TENANT_RPM_LIMIT=60
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MAX_UPLOAD_MB=20
MAX_ROWS_PER_DATASET=20000
